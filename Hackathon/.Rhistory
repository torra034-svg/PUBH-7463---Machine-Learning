#| label: library
#| message: FALSE
#| warning: FALSE
#| echo: TRUE
library(tidyverse)
#| label: import-data
#| message: FALSE
#| warning: FALSE
#| echo: TRUE
stroke <- read_csv("stroke.csv")
View(stroke)
#| label: log-regress
#| message: FALSE
#| warning: FALSE
#| echo: TRUE
stroke_model <- glm(
data = stroke,
family = binomial,
stroke ~ gender + age + heart_disease + bmi
)
summary(stroke_model)
#| label: log-regress
#| message: FALSE
#| warning: FALSE
#| echo: TRUE
stroke_model <- glm(
data = stroke,
family = binomial,
stroke ~ gender + age + heart_disease + bmi
)
summary(stroke_model)
exp(coef(stroke_model))
exp(confint(stroke_model))
#| label: stroke-predict
#| message: FALSE
#| warning: FALSE
#| echo: TRUE
stroke$prob <- predict(stroke_model, type = "response")
stroke$prob
#| label: stroke-plot
#| message: FALSE
#| warning: FALSE
#| echo: TRUE
ggplot(stroke, aes(x = prob)) +
geom_histogram()
#| label: stroke-plot
#| message: FALSE
#| warning: FALSE
#| echo: TRUE
ggplot(stroke, aes(x = prob)) +
geom_histogram(binwidth = 0.25)
#| label: stroke-plot
#| message: FALSE
#| warning: FALSE
#| echo: TRUE
ggplot(stroke, aes(x = prob)) +
geom_histogram(bins = 0.25)
#| label: stroke-plot
#| message: FALSE
#| warning: FALSE
#| echo: TRUE
ggplot(stroke, aes(x = prob)) +
geom_histogram(binwidth = 0.25)
#| label: stroke-plot
#| message: FALSE
#| warning: FALSE
#| echo: TRUE
ggplot(stroke, aes(x = prob)) +
geom_histogram()
#| label: stroke-plot
#| message: FALSE
#| warning: FALSE
#| echo: TRUE
ggplot(stroke, aes(x = prob)) +
geom_histogram(binwidth = 0.02)
#| label: stroke-plot
#| message: FALSE
#| warning: FALSE
#| echo: TRUE
ggplot(stroke, aes(x = prob)) +
geom_histogram() +
scale_x_continuous(limits = c(0,1))
#| label: stroke-plot
#| message: FALSE
#| warning: FALSE
#| echo: TRUE
ggplot(stroke, aes(x = prob)) +
geom_histogram() +
scale_x_continuous(limits = c(0,0.5))
#| label: stroke-plot
#| message: FALSE
#| warning: FALSE
#| echo: TRUE
ggplot(stroke, aes(x = prob)) +
geom_histogram() +
scale_x_continuous(limits = c(0,0.4))
#| label: stroke-plot
#| message: FALSE
#| warning: FALSE
#| echo: TRUE
ggplot(stroke, aes(x = prob)) +
geom_histogram() +
scale_x_continuous(limits = c(0,0.35))
#| label: stroke-plot
#| message: FALSE
#| warning: FALSE
#| echo: TRUE
ggplot(stroke, aes(x = prob)) +
geom_histogram() +
labs(x = "Predicted Probability of a Stroke")
View(stroke)
