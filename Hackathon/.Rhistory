library(tidyverse)
#| label:
#| message: FALSE
#| warning: FALSE
#| echo: TRUE
stroke <- read_csv("stroke.csv")
#| label:
#| message: FALSE
#| warning: FALSE
#| echo: TRUE
stroke <- read_csv("stroke.csv") |>
mutate(stroke = as_factor(stroke))
View(stroke)
#| label: decision-tree
#| message: FALSE
#| warning: FALSE
#| echo: TRUE
## Load the necessary libraries
library(rpart)
library(rpart.plot)
## Fit the decision tree
dec_tree <- rpart(stroke ~ age + gender, data = stroke)
rpart.plot(dec_tree)
