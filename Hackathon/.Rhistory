ggplot(stroke, aes(x = prob)) +
geom_histogram(binwidth = 0.25)
#| label: stroke-plot
#| message: FALSE
#| warning: FALSE
#| echo: TRUE
ggplot(stroke, aes(x = prob)) +
geom_histogram()
#| label: stroke-plot
#| message: FALSE
