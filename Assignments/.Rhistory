#| message: FALSE
#| warning: FALSE
#| echo: TRUE
# Create Models
model_glm_simple <- glm(data = stroke,
family = binomial,
stroke ~ age + bmi)
# Predict Probabilities
pred_glm_simple <- predict(model_glm_simple, newdata = stroke_test, type = "response")
# Calculate AUC
auc_glm_simple <- auc(roc(stroke_test$stroke, pred_glm_simple))
