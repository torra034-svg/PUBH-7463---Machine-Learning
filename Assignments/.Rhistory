`Cutpoint` = .x,
`Age Group` = c(
str_c(.x, ">"),
str_c("<=",.x)),
`N in group` = c(
sum(stroke$age > .x),
sum(stroke$age <= .x)),
`Prob of stroke` = c(
mean(stroke$stroke[stroke$age > .x], na.rm = TRUE),
mean(stroke$stroke[stroke$age <= .x], na.rm = TRUE)
)
))
