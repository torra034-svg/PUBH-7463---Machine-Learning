# Chunk 1: import-library
#| label: import-library
#| message: FALSE
#| warning: FALSE
#| echo: TRUE
library(tidyverse)
stroke <- read_csv("stroke.csv")
# Chunk 2: models
#| label: models
#| message: FALSE
#| warning: FALSE
#| echo: TRUE
model1 <- glm(
data = stroke,
family = binomial,
stroke ~ heart_disease + hypertension + smoking_status
)
model2 <- glm(
data = stroke,
family = binomial,
stroke ~ heart_disease + hypertension + smoking_status + age + avg_glucose_level + bmi
)
# Chunk 3: probability
#| label: probability
#| message: FALSE
#| warning: FALSE
#| echo: TRUE
stroke <- stroke |>
mutate(
prob1 = predict(model1, type = "response"),
prob2 = predict(model2, type = "response"),
## I also clean the data for future purposes
stroke1 = case_when(
stroke == 1 ~ "Stroke",
stroke == 0 ~ "No Stroke",
.default = NA)
)
# Chunk 4: plots
#| label: plots
#| message: FALSE
#| warning: FALSE
#| echo: TRUE
## Model 1 Plot
ggplot(stroke, aes(x = prob1, fill = stroke1)) +
geom_density(alpha = 0.5) +
labs(
x = "prob_stroke",
fill = "obs_stroke"
)
## Model 2 Plot
ggplot(stroke, aes(x = prob2, fill = stroke1)) +
geom_density(alpha = 0.5) +
labs(
x = "prob_stroke",
fill = "obs_stroke"
)
# Chunk 5: table-model
#| label: table-model
#| message: FALSE
#| warning: FALSE
#| echo: TRUE
library(kableExtra)
stroke_table <- stroke |>
pivot_longer(
cols = c(prob1, prob2),
names_to = "Model",
values_to = "prob_stroke"
) |>
mutate(
Model = case_when(
Model == "prob1" ~ "Model 1",
Model == "prob2" ~ "Model 2",
.default = NA)
)|>
group_by(Model, stroke1) |>
summarize(
"Mean prediction" = mean(prob_stroke),
"Median prediction" = median(prob_stroke),
"SD prediction" = sd(prob_stroke),
.groups = "drop"
) |>
rename(`Stroke Observed?` = stroke1)
kable(stroke_table)
# Chunk 6: model-3
#| label: model-3
#| message: FALSE
#| warning: FALSE
#| echo: TRUE
model3 <- glm(
data = stroke,
family = binomial,
stroke ~ gender + age + hypertension + heart_disease + ever_married + work_type + Residence_type + avg_glucose_level + bmi + smoking_status + stroke
)
stroke_q2 <- stroke |>
mutate(
prob3 = predict(model3, type = "response")
)
# Chunk 7: model-3-plot
#| label: model-3-plot
#| message: FALSE
#| warning: FALSE
#| echo: TRUE
## Model 3 Plot
ggplot(stroke_q2, aes(x = prob3, fill = stroke1)) +
geom_density(alpha = 0.5) +
labs(
x = "prob_stroke",
fill = "obs_stroke"
)
# Chunk 8: table-model-3
#| label: table-model-3
#| message: FALSE
#| warning: FALSE
#| echo: TRUE
stroke_table_q2 <- stroke_q2 |>
pivot_longer(
cols = c(prob1, prob2, prob3),
names_to = "Model",
values_to = "prob_stroke"
) |>
mutate(
Model = case_when(
Model == "prob1" ~ "Model 1",
Model == "prob2" ~ "Model 2",
Model == "prob3" ~ "Model 3",
.default = NA)
)|>
group_by(Model, stroke1) |>
summarize(
"Mean prediction" = mean(prob_stroke),
"Median prediction" = median(prob_stroke),
"SD prediction" = sd(prob_stroke),
.groups = "drop"
) |>
rename(`Stroke Observed?` = stroke1)
kable(stroke_table_q2)
# Chunk 9: 50-age-comparison
#| label: 50-age-comparison
#| message: FALSE
#| warning: FALSE
#| echo: TRUE
stroke_q3 <- stroke_q2 |>
mutate(
Age = case_when(
age > 50 ~ "Age > 50",
.default = "Age <= 50"
)
)
# Chunk 10: q3-plot
#| label: q3-plot
#| message: FALSE
#| warning: FALSE
#| echo: TRUE
ggplot(stroke_q3, aes(x = prob3, fill = stroke1)) +
geom_density(alpha = 0.5) +
facet_wrap(~ Age) +
labs(
x = "prob_stroke",
fill = "obs_stroke"
)
# Chunk 11: q3-table
#| label: q3-table
#| message: FALSE
#| warning: FALSE
#| echo: TRUE
stroke_table_q3 <- stroke_q3 |>
group_by(Age, stroke1) |>
select(-prob1, -prob2) |>
summarize(
"Mean prediction" = mean(prob3),
"Median prediction" = median(prob3),
"SD prediction" = sd(prob3),
.groups = "drop"
) |>
rename(`Stroke Observed?` = stroke1)
kable(stroke_table_q3)
# Chunk 12: cutpoints
#| label: cutpoints
#| message: FALSE
