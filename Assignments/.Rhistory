# Chunk 1: library
#| label: library
#| message: FALSE
#| warning: FALSE
#| echo: TRUE
library(tidyverse) #clean data
library(tidymodels)
library(kableExtra) ## create nice data tables
atus <- read_csv("atus.csv")
# Chunk 2: split-data
#| label: split-data
#| message: FALSE
#| warning: FALSE
#| echo: TRUE
set.seed(888)
atus_split <- initial_split(
atus,
prop = 0.70,
strata = SCHAPPY
)
atus_train <- training(atus_split)
atus_test <- testing(atus_split)
# Chunk 3: specs
#| label: specs
#| message: FALSE
#| warning: FALSE
#| echo: TRUE
lin_reg <- linear_reg() |>
set_engine("glm") |>
set_mode("regression")
# Chunk 4: model
#| label: model
#| message: FALSE
#| warning: FALSE
#| echo: TRUE
lin_reg_model <- lin_reg |>
fit(SCHAPPY ~ HH_SIZE + HH_CHILD + HH_NUMKIDS + AGE + SEX + RACE + MARST + GENHEALTH + HIGHBP + PAINMED + BLS_LEIS_RELAX,
data = atus_train)
# Chunk 5: predict
#| label: predict
#| message: FALSE
#| warning: FALSE
#| echo: TRUE
predict_lin_reg_model <- predict(lin_reg_model, new_data = atus_test)
## Note to self: only include type = "prob" for classification models
# Chunk 6: bind-predictions
#| label: bind-predictions
#| message: FALSE
#| warning: FALSE
#| echo: TRUE
atus_pred <- atus_test |>
bind_cols(predict_lin_reg_model)
# Chunk 7: compare-viz-happy
#| label: compare-viz-happy
#| message: FALSE
#| warning: FALSE
#| echo: TRUE
ggplot(atus_pred, aes(x = SCHAPPY, y = .pred)) +
geom_point() +
geom_abline(slope = 1, intercept = 0, linetype = "dashed") +
labs(
x = "Observed SCHAPPY",
y = "Predicted SCHAPPY",
title = "Observed vs Predicted Happiness")
# Chunk 8: SCHAPPY-table
#| label: SCHAPPY-table
#| message: FALSE
#| warning: FALSE
#| echo: TRUE
happy_table <- atus_pred |>
select(CASEID, HH_SIZE , HH_CHILD , HH_NUMKIDS , AGE , SEX , RACE , MARST , GENHEALTH , HIGHBP , PAINMED , BLS_LEIS_RELAX, SCHAPPY, .pred) |>
kable()
happy_table
# Chunk 9: happy-coefficients
#| label: happy-coefficients
#| message: FALSE
#| warning: FALSE
#| echo: TRUE
coefficients <- lin_reg_model |>
tidy() |>
mutate(absolute_magnitude = abs(estimate)) |>
arrange(desc(absolute_magnitude)) |>
slice_head(n=10) |>
select(term, estimate)
kable(coefficients)
# Chunk 10: lasso-spec
#| label: lasso-spec
#| message: FALSE
#| warning: FALSE
#| echo: TRUE
lasso_spec <-
linear_reg(penalty = tune(), mixture = 1) |>
set_engine("glmnet")
# Chunk 11: locate-lambda-best-value
#| label: locate-lambda-best-value
#| message: FALSE
#| warning: FALSE
#| echo: TRUE
## Define folds
folds <- vfold_cv(atus_train, v = 5)
## Evaluate different values of lambda
lasso_results <- tune_grid(
lasso_spec,
SCHAPPY ~ HH_SIZE + HH_CHILD + HH_NUMKIDS + AGE + SEX + RACE +
MARST + GENHEALTH + HIGHBP + PAINMED + BLS_LEIS_RELAX,
resamples = folds
)
## Find optimal lambda value. This will be the value with the lowest RMSE value.
best_lambda <- select_best(lasso_results, metric = "rmse")
best_lambda_value <- pull(best_lambda, penalty)
# Chunk 12: lasso-model
#| label: lasso-model
#| message: FALSE
#| warning: FALSE
#| echo: TRUE
lasso_spec <-
linear_reg(penalty = best_lambda_value, mixture = 1) |>
set_engine("glmnet")
lasso_model <- lasso_spec |>
fit( SCHAPPY ~ HH_SIZE + HH_CHILD + HH_NUMKIDS + AGE + SEX + RACE +
MARST + GENHEALTH + HIGHBP + PAINMED + BLS_LEIS_RELAX,
data = atus_train)
# Chunk 13: predict-lasso
#| label: predict-lasso
#| message: FALSE
#| warning: FALSE
#| echo: TRUE
predict_lasso_model <- predict(lasso_model, new_data = atus_test)
## Note to self: only include type = "prob" for classification models
# Chunk 14: bind-predictions-lasso
#| label: bind-predictions-lasso
#| message: FALSE
#| warning: FALSE
#| echo: TRUE
lasso_atus_pred <- atus_test |>
bind_cols(predict_lasso_model)
# Chunk 15: compare-viz-happy-lasso
#| label: compare-viz-happy-lasso
#| message: FALSE
#| warning: FALSE
#| echo: TRUE
ggplot(lasso_atus_pred, aes(x = SCHAPPY, y = .pred)) +
geom_point() +
labs(
x = "Observed SCHAPPY",
y = "Predicted SCHAPPY",
title = "Observed vs LASSO Predicted Happiness")
# Chunk 16: happy-coefficients-lasso
#| label: happy-coefficients-lasso
#| message: FALSE
#| warning: FALSE
#| echo: TRUE
lasso_coefficients <- lasso_model |>
tidy() |>
mutate(absolute_magnitude = abs(estimate)) |>
arrange(desc(absolute_magnitude)) |>
slice_head(n=10) |>
select(term, estimate) |>
filter(estimate != 0)
kable(lasso_coefficients)
# Chunk 17: compare-lin-reg-lasso
#| label: compare-lin-reg-lasso
#| message: FALSE
#| warning: FALSE
#| echo: TRUE
coefficients_comparison <- full_join(coefficients, lasso_coefficients, by = "term") |>
rename(linear_regression_estimate = estimate.x,
lasso_estimate = estimate.y)
kable(coefficients_comparison)
# Chunk 18: mse-calculation
#| label: mse-calculation
#| message: FALSE
#| warning: FALSE
#| echo: TRUE
lin_reg_mse <- atus_pred |>
summarize(
MSE = mean((SCHAPPY - .pred)^2)
)
lin_reg_mse
lasso_mse <- lasso_atus_pred |>
summarise(
MSE = mean((SCHAPPY - .pred)^2)
)
lasso_mse
# Chunk 19: two-stage-lasso
